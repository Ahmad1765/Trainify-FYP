# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to the browser by Vite.

# --- Supabase (target stack) -------------------------------------------------
# Project Settings -> Data API -> Project URL / API keys in the Supabase dashboard.
# The anon (publishable) key is safe in client code; it is protected by RLS.
# NEVER put the service_role / secret key in this file — it bypasses RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# --- Google OAuth for Capacitor native sign-in -------------------------------
# Web OAuth is configured in the Supabase dashboard and needs no client vars.
# These are only required for the native Android/iOS flow.
VITE_GOOGLE_CLIENT_ID=
VITE_ANDROID_CLIENT_ID=
VITE_IOS_CLIENT_ID=

# --- Firebase (legacy — removed during the Supabase migration) ---------------
# Kept here only until the migration completes. These are public web keys.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
